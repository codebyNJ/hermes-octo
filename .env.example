# ---------------------------------------------------------------------------
# Set these via `railway variables --set NAME=value` (or the dashboard).
# DATABASE_URL is injected automatically once you attach a Postgres add-on.
# ---------------------------------------------------------------------------

# Bearer token clients must present. Generate with: openssl rand -hex 32
API_SERVER_KEY=

# Allowed browser origin(s) for /v1/*
API_SERVER_CORS_ORIGINS=https://hermes.nijeeshnj.tech

# Single Groq key, used by both Hermes (its own LLM calls) and Honcho (deriver).
GROQ_API_KEY=
