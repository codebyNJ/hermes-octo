# ---------------------------------------------------------------------------
# Set these as environment variables in Render (Dashboard → service → Environment).
# `sync: false` keys in render.yaml mean you set the value in the dashboard.
# PORT is injected by Render automatically.
# ---------------------------------------------------------------------------

# Bearer token clients must present. Generate with: openssl rand -hex 32
API_SERVER_KEY=0058530273746f31541615decd99f67bd66f30cc3947143153001c957378144b

# Groq powers both Hermes' chat and Honcho's deriver reasoning.
GROQ_API_KEY=

# OpenRouter fallback when Groq hits rate limits. Free, no card.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Neon Postgres connection string (with pgvector extension).
# Get from: https://console.neon.tech → project → Dashboard → Connection string
# Format:  postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=

# Allowed browser origin(s) for /v1/*
API_SERVER_CORS_ORIGINS=https://<username>-hermes.hf.space

# Disable Redis cache (no Redis in this deploy)
CACHE_ENABLED=false
