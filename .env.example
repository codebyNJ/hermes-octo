# ---------------------------------------------------------------------------
# Set these as secrets in Koyeb (Dashboard → service → Settings → Variables,
# or via the Koyeb CLI). PORT is injected by Koyeb automatically.
# ---------------------------------------------------------------------------

# Bearer token clients must present. Generate with: openssl rand -hex 32
API_SERVER_KEY=

# Allowed browser origin(s) for /v1/*
API_SERVER_CORS_ORIGINS=https://hermes.nijeeshnj.tech

# Groq powers Hermes' inference
GROQ_API_KEY=

# Cloud Honcho key (free at https://honcho.dev). Optional, but without it
# the second-brain has no long-term memory.
HONCHO_API_KEY=
