# ---------------------------------------------------------------------------
# Set these as environment variables in Render (Dashboard → service → Environment).
# `sync: false` keys in render.yaml mean you set the value in the dashboard.
# PORT is injected by Render automatically.
# ---------------------------------------------------------------------------

# Bearer token clients must present. Generate with: openssl rand -hex 32
API_SERVER_KEY=0058530273746f31541615decd99f67bd66f30cc3947143153001c957378144b

# Groq powers both Hermes' chat and Honcho's deriver reasoning.
GROQ_API_KEY=

# OpenRouter fallback when Groq hits rate limits. Free, no card.
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Z.AI GLM-4.7-Flash — primary provider. 50 RPD free, 200K context, tool calling.
# Get from: https://z.ai (or https://open.bigmodel.cn for China)
ZAI_API_KEY=

# Google Gemini fallback. Free 1500 RPD, no card.
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Exa AI — powers web_search/web_extract (required since we're on OpenRouter,
# not the paid Nous Portal) AND the exa MCP for GTM/market/company research.
# Get from: https://dashboard.exa.ai  — set this in HF Secrets, never commit it.
EXA_API_KEY=

# GitHub read-only PAT — lets the github MCP read your commits/PRs/repos so the
# hireme skill can cite real proof. A classic token with NO scopes (public only)
# or fine-grained read-only is enough. Get from: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Neon Postgres connection string (with pgvector extension).
# Get from: https://console.neon.tech → project → Dashboard → Connection string
# Format:  postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=

# Allowed browser origin(s) for /v1/*
API_SERVER_CORS_ORIGINS=https://<username>-hermes.hf.space

# Disable Redis cache (no Redis in this deploy)
CACHE_ENABLED=false
